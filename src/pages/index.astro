---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import HeroSection from "@/components/HeroSection.astro";
import MarqueeBanner from "@/components/MarqueeBanner.astro";
import { ProjectsSection } from "@/components/ProjectsSection";
import ExperienceSection from "@/components/ExperienceSection.astro";
import { ContactSection } from "@/components/ContactSection";
import Footer from "@/components/Footer.astro";
import FloatingWhatsApp from "@/components/FloatingWhatsApp.astro";
---

<Layout>
  <!-- Main comic dots and theme container -->
  <div class="comic-dots min-h-screen flex flex-col justify-between relative selection:bg-neo-primary selection:text-black overflow-x-hidden">
    <!-- Floating Comic Shapes (Background) -->
    <div class="absolute top-[18%] left-[3%] opacity-25 pointer-events-none animate-float-y z-0 hidden lg:block">
      <div class="w-16 h-16 bg-neo-primary border-3 border-black rounded-lg shadow-neo transform rotate-12 flex items-center justify-center">
        <svg class="w-8 h-8 text-black" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
      </div>
    </div>

    <div class="absolute top-[45%] right-[4%] opacity-25 pointer-events-none animate-float-x z-0 hidden lg:block">
      <div class="w-20 h-20 bg-neo-secondary border-3 border-black rounded-xl shadow-neo transform -rotate-12 flex items-center justify-center">
        <svg class="w-10 h-10 text-black" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
      </div>
    </div>

    <div class="absolute bottom-[28%] left-[4%] opacity-25 pointer-events-none animate-float-y z-0 hidden lg:block">
      <div class="w-16 h-16 bg-neo-accent border-3 border-black rounded-full shadow-neo transform rotate-6 flex items-center justify-center font-display font-black text-lg text-black select-none">
        GO!
      </div>
    </div>

    <div class="absolute bottom-[12%] right-[5%] opacity-25 pointer-events-none animate-float-x z-0 hidden lg:block">
      <div class="w-14 h-14 bg-white border-3 border-black rounded-lg shadow-neo transform -rotate-6 flex items-center justify-center font-display font-black text-2xl text-black select-none">
        &lt;/&gt;
      </div>
    </div>

    <!-- Page Content -->
    <div class="relative z-10">
      <Navbar />

      <main class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 flex flex-col gap-12 sm:gap-16">
        <HeroSection />

        <div class="-mx-4 sm:-mx-6 md:-mx-8">
          <MarqueeBanner />
        </div>

        <ProjectsSection client:visible />

        <ExperienceSection />

        <ContactSection client:visible />
      </main>
    </div>

    <Footer />
    <FloatingWhatsApp />
  </div>
</Layout>
