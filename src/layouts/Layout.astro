---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Hibban Habiburrahman - Full-Stack Developer and IT Support",
  description = "Portofolio Hibban Habiburrahman, Full-Stack Dev & IT Support di Bandung. Spesialis Golang, Laravel, Nuxt 3, dan troubleshooting sistem.",
  image = "/foto-profil.webp",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://habiburrahman.web.id").toString(),
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://habiburrahman.web.id";
const fullImageUrl = new URL(image, siteUrl).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "Hibban Habiburrahman Portfolio",
      "description": description,
      "inLanguage": ["id", "en"]
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/#profilepage`,
      "url": canonicalURL,
      "name": title,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": {
        "@type": "Person",
        "@id": `${siteUrl}/#person`,
        "name": "Hibban Habiburrahman",
        "alternateName": "Hibban",
        "url": `${siteUrl}/`,
        "image": `${siteUrl}/foto-profil.webp`,
        "jobTitle": "Full-Stack Developer & IT Support",
        "worksFor": {
          "@type": "Organization",
          "name": "PT. Digital Rayafokus"
        },
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "STT Pratama Adi"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Bandung",
          "addressRegion": "Jawa Barat",
          "addressCountry": "ID"
        },
        "description": description,
        "knowsAbout": [
          "Web Developer",
          "Web Development",
          "Full Stack Web Developer",
          "Software Engineer",
          "Backend Developer",
          "Frontend Developer",
          "Golang",
          "Laravel",
          "Nuxt 3",
          "Vue.js",
          "Tailwind CSS",
          "PostgreSQL",
          "Supabase",
          "IT Support",
          "Hardware Troubleshooting",
          "Printer Troubleshooting",
          "Full-Stack Development"
        ],
        "sameAs": [
          "https://github.com/Mighty-SEA",
          "https://www.linkedin.com/in/hibban-habiburrahman-a47608429/"
        ]
      }
    }
  ]
};
---

<!doctype html>
<html lang="id" data-lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Script to prevent flash of wrong language and theme -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('portfolio_theme') || 'theme-sunny';
          document.documentElement.className = savedTheme;

          const savedLang = localStorage.getItem('portfolio_lang');
          const detectedLang = savedLang || (navigator.language && navigator.language.startsWith('id') ? 'id' : 'en');
          document.documentElement.setAttribute('data-lang', detectedLang);
          document.documentElement.setAttribute('lang', detectedLang);
        } catch (e) {}
      })();
    </script>

    <!-- Google Site Verification (GSC) -->
    <meta name="google-site-verification" content="uRlvr1BUerqfRUDI7p1J9gR285xc-kPG9nZsTLZ4CgY" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content="Hibban Portfolio" />
    <meta name="theme-color" content="#FFD23F" />

    <!-- Multilingual Alternate Hreflang Tags -->
    <link rel="alternate" hreflang="id" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Mobile App Capabilities -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Hibban Portfolio" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hibban Habiburrahman" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Mighty_SEA" />
    <meta name="twitter:creator" content="@Mighty_SEA" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- Fonts: Outfit (Heading), Space Grotesk (Display), Inter (Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;800;900&family=Space+Grotesk:wght@500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body id="top" class="min-h-screen bg-background text-foreground font-sans antialiased selection:bg-main selection:text-black">
    <slot />

    <!-- Scroll Reveal Intersection Observer (Muncul saat discroll, menghilang saat dilewati) -->
    <script is:inline>
      function initScrollReveal() {
        if (typeof window === 'undefined' || !('IntersectionObserver' in window)) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            } else {
              // Menghilang saat dilewati / keluar dari viewport
              entry.target.classList.remove('active');
            }
          });
        }, {
          threshold: 0.05,
          rootMargin: '0px 0px -40px 0px'
        });

        function observeElements() {
          document.querySelectorAll('.reveal').forEach((el) => {
            observer.observe(el);
          });
        }

        observeElements();

        // Observe elements hydrated dynamically by React islands
        const mo = new MutationObserver(() => {
          observeElements();
        });
        mo.observe(document.body, { childList: true, subtree: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    </script>
  </body>
</html>

